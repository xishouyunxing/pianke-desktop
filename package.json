{
  "name": "pianke-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1 --port 1420",
    "prepare:python": "powershell -ExecutionPolicy Bypass -File scripts/prepare_desktop_python.ps1",
    "build": "tauri build && npm run check:no-python-bundle",
    "build:rust": "tauri build && npm run check:no-python-bundle",
    "build:ui": "vue-tsc --noEmit && vite build",
    "check:no-python-bundle": "powershell -ExecutionPolicy Bypass -File scripts/check_no_python_bundle.ps1",
    "preview": "vite preview --host 127.0.0.1 --port 1420"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
