{
  "name": "pianke-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:ui": "vite --host 127.0.0.1 --port 1420",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build_rust_release.ps1",
    "build:rust": "powershell -ExecutionPolicy Bypass -File scripts/build_rust_release.ps1",
    "build:ui": "vue-tsc --noEmit && vite build",
    "check:versions": "powershell -ExecutionPolicy Bypass -File scripts/check_version_consistency.ps1",
    "check:no-python-bundle": "powershell -ExecutionPolicy Bypass -File scripts/check_no_python_bundle.ps1",
    "smoke:release-rust": "powershell -ExecutionPolicy Bypass -File scripts/smoke_release_rust_backend.ps1",
    "smoke:rc": "powershell -ExecutionPolicy Bypass -File scripts/smoke_rc.ps1",
    "test:opencv-release": "powershell -ExecutionPolicy Bypass -File scripts/test_opencv_release.ps1",
    "preview": "vite preview --host 127.0.0.1 --port 1420"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^2.2.0"
  }
}
